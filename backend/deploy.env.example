# Copy this file to deploy.env, fill in your values, then run: source deploy.env
# deploy.env is in .gitignore, so your account ID never reaches GitHub.
export APPROVED_ACCOUNT=<12-digit-aws-account-id>
export AWS_PROFILE=<your-aws-profile>
export AWS_REGION=us-east-1
export AWS_DEFAULT_REGION=us-east-1
export JSII_RUNTIME_PACKAGE_CACHE=disabled
