{
  "project_name": "doclens-document-explainer",
  "mode": "solo",
  "source_spec": "mini-project-05-document-explainer.md",
  "vision": {
    "problem": "People cannot understand dense legal documents or spot risky clauses",
    "target_users": "Everyday non-legal people",
    "success_metrics": [
      "one-command cdk deploy",
      "document -> plain-English breakdown with flagged risks on the page",
      "audit log per agent",
      "not-legal-advice disclaimer on every result"
    ],
    "business_model": "learning/portfolio, none"
  },
  "constraints": {
    "timeline": "1-2 day build, demo to guide",
    "team_size": 1,
    "budget": "low",
    "region": "us-east-1",
    "compliance": [],
    "compliance_review": "not_needed",
    "data_types": [
      "fake sample documents only"
    ],
    "non_negotiables": [
      "Step Functions",
      "CDK (Python)",
      "Bedrock converse, no API key in code",
      "not-legal-advice disclaimer",
      "local tests before deploy",
      "no account ID or secrets in code (deploy.env, gitignored)"
    ]
  },
  "stakeholders": {
    "driver": "owner",
    "approvers": [
      "mentor",
      "company reviewer"
    ],
    "approval_rule": "both must agree",
    "consulted": [
      "teammates"
    ]
  },
  "nfrs": {
    "latency": "<2 min typical",
    "max_input_chars": 20000,
    "availability": "best effort",
    "retries": 3,
    "cost_ceiling_usd": 5,
    "scale": "single user"
  },
  "risks": [
    {
      "id": "R1",
      "description": "AWS setup blockers (Bedrock access, IAM, bootstrap)",
      "status": "resolved"
    },
    {
      "id": "R2",
      "description": "AI misreads or invents clause content",
      "status": "mitigated: validation, original text shown, disclaimer"
    },
    {
      "id": "R3",
      "description": "Not finishing in 1-2 days",
      "status": "resolved"
    },
    {
      "id": "R4",
      "description": "CDK and Step Functions new to builder",
      "status": "mitigated: code walkthrough"
    },
    {
      "id": "R5",
      "description": "Slow local DNS (15 s) breaks CDK credential lookup",
      "status": "workaround: hotspot or 8.8.8.8"
    }
  ],
  "scope": {
    "built": [
      "paste/attach .txt",
      "3-agent Step Functions pipeline",
      "async submit + poll with real progress",
      "result on page",
      "S3 + CloudFront website",
      "secrets redaction"
    ],
    "dropped_by_choice": [
      "SES email",
      "S3 presigned upload for large files"
    ],
    "removed_by_owner": [
      "demo-only notice on page",
      "red flags box on result screen"
    ]
  },
  "decisions": {
    "ADR-001": "Python 3.12 Lambdas + CDK (Python), pytest",
    "ADR-002": "data passes through the state machine",
    "ADR-003": "start Lambda behind HTTP API; POST /jobs, GET /jobs/{job_id}; polling",
    "ADR-004": "two DynamoDB tables: jobs, audit_log",
    "ADR-005": "one prompt.md per agent, JSON between agents, validated in code",
    "ADR-006": "mocked tests + real runs on deployed stack",
    "ADR-008": "account read from deploy.env; confirm account before every deploy",
    "D7": "frontend built by owner (frontend/index.html)"
  },
  "api": {
    "routes": [
      "POST /jobs",
      "GET /jobs/{job_id}"
    ],
    "statuses": [
      "RUNNING",
      "SUCCEEDED",
      "FAILED"
    ],
    "status_fields": [
      "job_id",
      "status",
      "completed_stages",
      "result",
      "error"
    ],
    "cors": true,
    "throttle": "2 req/s, burst 5"
  },
  "data": {
    "tables": {
      "suman-jobs": {
        "pk": "job_id"
      },
      "suman-audit-log": {
        "pk": "job_id",
        "sk": "stage"
      }
    },
    "billing": "on-demand",
    "removal": "destroy"
  },
  "agents": {
    "pattern": "sequential pipeline",
    "model": "us.anthropic.claude-sonnet-4-6",
    "stages": [
      "clause_extractor",
      "risk_flagger",
      "plain_english_rewriter"
    ],
    "risk_levels": [
      "low",
      "medium",
      "high"
    ],
    "guardrails": [
      "length cap",
      "anti-invention check",
      "exact clause coverage",
      "fixed label menus",
      "prompt-injection rule",
      "code-fence stripping",
      "secret redaction",
      "disclaimer from code"
    ],
    "demo_switch": "shared/fault_injection.py; DEMO_FAULTS=on for the 3 agents (infra/settings.py); marker [[DEMO-FAIL:<agent>]]"
  },
  "layout": {
    "lambda_code": "backend/src/{agents,api,shared}",
    "agent_prompts": "backend/src/agents/<agent>/prompt.md",
    "infra": "backend/infra/{stack,settings,storage,agents,orchestrator,api,website}.py",
    "tests": "backend/tests/{agents,api,shared,infra} (82 tests)",
    "frontend": "frontend/index.html",
    "test_docs": "test_docs/{input,result}",
    "docs": "docs/{decisions,architecture.html,audit-log-sample.json}",
    "deploy_settings": "backend/deploy.env (gitignored); template deploy.env.example"
  },
  "deployment": {
    "cloud_account_map": {
      "demo": "see APPROVED_ACCOUNT in backend/deploy.env"
    },
    "credentials": "AWS_PROFILE in backend/deploy.env",
    "region": "us-east-1",
    "stack": "suman-doc-explainer",
    "naming": "all named resources start with 'suman-'",
    "outputs": [
      "ApiUrl",
      "FrontendUrl"
    ],
    "gate": "before any deploy: source deploy.env, sts get-caller-identity must equal APPROVED_ACCOUNT, owner confirms",
    "live_version": "restructure + secrets guardrail + UI changes + demo switch (deployed 2026-11-23)",
    "pending_redeploy": []
  },
  "repo": {
    "host": "GitHub (private recommended)",
    "excluded": [
      "backend/deploy.env",
      ".venv",
      "cdk.out"
    ]
  },
  "submission": {
    "done": [
      "3 agent Lambdas with own prompts",
      "Step Functions Retry/Catch",
      "cdk deploy whole stack",
      "Bedrock converse, no key in code",
      "submit -> poll -> render",
      "README with diagram + deploy steps",
      "audit log from real run",
      "code on GitHub"
    ],
    "todo": [
      "run the Catch demo once",
      "screenshot of rendered breakdown",
      "cdk destroy after demo"
    ],
    "not_met": [
      "bounded agent loop per stage",
      "Bedrock tools with schemas",
      "max-iterations escalation demo",
      "EventBridge scheduled run (stretch)"
    ]
  }
}